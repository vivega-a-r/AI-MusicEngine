# IncuBrix Music Studio Environment Configuration

# Server Settings
APP_NAME="IncuBrix Music Studio"
APP_VERSION="1.0.0"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Audio Engineering Standards
SAMPLE_RATE=48000
TARGET_LUFS=-16.0
MAX_TRUE_PEAK_DBTP=-1.0
MIN_DURATION_S=5.0
MAX_DURATION_S=300.0

# Storage Paths
STORAGE_DIR="./storage/audio"
DB_PATH="./storage/jobs.db"

# Security & Secret Keys
SECRET_KEY="incubrix-super-secret-key-change-in-production-2026"

# Authentication (Optional Firebase Credentials)
# Leave empty for Honest Local Development Mode (Full features enabled)
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_PATH=""
ENABLE_LOCAL_DEV_AUTH=true

# Concurrency & Worker Limits
MAX_WORKER_CONCURRENCY=4
